# Copy this file to .env and replace the placeholder locally.
# Never commit the real .env file.
# Either name is accepted by the Google client. Never commit a real key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Optional outside Docker: automatically claim and index uploaded Java documents.
JAVA_API_BASE_URL=http://localhost:8080
# Generate a unique random secret of at least 32 bytes and set the same value in the Java backend.
JAVA_WORKER_API_KEY=
DOCUMENT_WORKER_INTERVAL_SECONDS=5
RAG_INDEX_DIR=.rag-index
