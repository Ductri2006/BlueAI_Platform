DB_PASSWORD=replace-local-database-password
# Product catalogue: use the partner host assigned to this environment.
BLUECOM_PRODUCTS_BASE_URL=https://api.sandbox.bluesim.com.vn/api/open/v1
BLUECOM_PRODUCTS_API_KEY=
BLUECOM_PRODUCTS_TIMEOUT=30s
BLUECOM_PRODUCTS_AUTO_SYNC_ENABLED=false
BLUECOM_PRODUCTS_REFRESH_INTERVAL=15m
MYSQL_ROOT_PASSWORD=replace-local-root-password
APP_WORKER_API_KEY=

# Provider model routing: use the low-cost model first and fail over only when
# the provider reports a temporary capacity/rate/connection error.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_FALLBACK_MODELS=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001

# Generate at least 32 random bytes and Base64-encode them.
APP_JWT_SECRET=replace-with-a-base64-secret
APP_JWT_ISSUER=blueai-auth
APP_JWT_AUDIENCE=blueai-api
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Public widget origins. Use an explicit comma-separated allowlist in production;
# the local default in application.properties is '*' because the widget is public.
APP_WIDGET_ALLOWED_ORIGINS=*
APP_WIDGET_CLEANUP_INTERVAL=15m
# Docker Compose starts Redis and enables shared widget counters automatically.
# Set false only when running the Java backend outside Docker without Redis.
APP_WIDGET_REDIS_ENABLED=true
# Use a long random value in production. It is used to pseudonymize client IPs
# before they become Redis rate-limit keys; it is not an API credential.
APP_WIDGET_CLIENT_KEY_SALT=replace-with-a-long-random-widget-client-key-salt
# Enable only when the backend is reachable exclusively through a reverse proxy
# that overwrites X-Forwarded-For. Never enable it on a directly public API.
APP_WIDGET_TRUST_FORWARDED_HEADERS=false
# Required whenever header trust is true. Use only CIDRs of the proxy that can
# reach auth-api, never 0.0.0.0/0 or a public client range.
APP_WIDGET_TRUSTED_PROXY_CIDRS=

# These limits are passed through Docker Compose and can be tuned from observed
# traffic without changing source code.
APP_WIDGET_SESSION_TTL=30m
APP_WIDGET_RATE_LIMIT_WINDOW=1m
APP_WIDGET_MAX_SESSION_CREATIONS=10
APP_WIDGET_MAX_MESSAGES_PER_CLIENT=30
APP_WIDGET_MAX_MESSAGES_PER_SESSION=12
APP_WIDGET_MAX_MESSAGES_PER_SESSION_TOTAL=120
APP_WIDGET_DUPLICATE_REPLAY_LIMIT=2
APP_WIDGET_DUPLICATE_WINDOW=2m
APP_WIDGET_REQUEST_LOCK_TTL=60s

# Public self-registration must remain disabled. This account is created once when absent.
APP_PUBLIC_REGISTRATION_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=admin@blueai.local
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_BOOTSTRAP_ADMIN_FULL_NAME=BlueAI Administrator

# RAG retriever contract: see RAG_WORKER_CONTRACT.md.
APP_RAG_RETRIEVAL_BASE_URL=http://host.docker.internal:8000
APP_RAG_RETRIEVAL_SEARCH_PATH=/v1/retrieval/search
APP_RAG_ALLOW_SHARED_DEMO_KNOWLEDGE=false

# OpenAI-compatible chat/completions endpoint.
APP_LLM_BASE_URL=http://host.docker.internal:8000
APP_LLM_CHAT_PATH=/v1/chat/completions
APP_LLM_API_KEY=internal-rag-service
APP_LLM_MODEL=gemini-3.5-flash-lite
APP_LLM_MAX_ATTEMPTS=3
APP_LLM_RETRY_INITIAL_DELAY=250ms
APP_LLM_RETRY_MAX_DELAY=2s
