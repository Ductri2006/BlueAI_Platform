DB_PASSWORD=replace-local-database-password
MYSQL_ROOT_PASSWORD=replace-local-root-password

# Generate at least 32 random bytes and Base64-encode them.
APP_JWT_SECRET=replace-with-a-base64-secret
APP_JWT_ISSUER=blueai-auth
APP_JWT_AUDIENCE=blueai-api
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Public self-registration must remain disabled. This account is created once when absent.
APP_PUBLIC_REGISTRATION_ENABLED=false
APP_BOOTSTRAP_ADMIN_EMAIL=admin@blueai.local
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_BOOTSTRAP_ADMIN_FULL_NAME=BlueAI Administrator

# RAG retriever contract: see RAG_WORKER_CONTRACT.md.
APP_RAG_RETRIEVAL_BASE_URL=http://host.docker.internal:8000
APP_RAG_RETRIEVAL_SEARCH_PATH=/v1/retrieval/search
APP_RAG_ALLOW_SHARED_DEMO_KNOWLEDGE=false

# OpenAI-compatible chat/completions endpoint.
APP_LLM_BASE_URL=http://host.docker.internal:8000
APP_LLM_CHAT_PATH=/v1/chat/completions
APP_LLM_API_KEY=internal-rag-service
APP_LLM_MODEL=gemini-3.5-flash-lite
