# Copy this file to BE/.env on the deployment host. BE/.env is ignored by Git.
# Replace every placeholder with a new secret; do not reuse local development
# values and do not add the resulting file to source control.

GOOGLE_API_KEY=replace-with-provider-key
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite
GEMINI_CHAT_FALLBACK_MODELS=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
DB_PASSWORD=replace-with-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# Generate at least 32 random bytes, then Base64-encode them.
APP_JWT_SECRET=replace-with-a-new-base64-secret
APP_JWT_ISSUER=blueai-auth
APP_JWT_AUDIENCE=blueai-api

# Generate a unique random secret of at least 32 bytes before starting Compose.
APP_WORKER_API_KEY=

# Keep demo knowledge disabled. Transient provider failures are retried with
# bounded exponential backoff before the API returns an error to the user.
APP_RAG_ALLOW_SHARED_DEMO_KNOWLEDGE=false
APP_LLM_MAX_ATTEMPTS=3
APP_LLM_RETRY_INITIAL_DELAY=250ms
APP_LLM_RETRY_MAX_DELAY=2s

# Explicit HTTPS browser origins only, with no trailing slash and no wildcard.
APP_CORS_ALLOWED_ORIGINS=https://app.example.com
APP_WIDGET_ALLOWED_ORIGINS=https://www.example.com,https://shop.example.com

# This salt pseudonymizes address-based Redis keys. Use 32+ random characters.
APP_WIDGET_CLIENT_KEY_SALT=replace-with-a-new-random-widget-salt-at-least-32-chars

# The frontend Nginx overwrites X-Forwarded-For. Configure only the source CIDR
# from which that trusted proxy reaches auth-api; never use 0.0.0.0/0.
# Find it on the deploy host with: docker network inspect <network-name>
APP_WIDGET_TRUSTED_PROXY_CIDRS=replace-with-trusted-proxy-cidr

# First deployment only: create the initial ADMIN account. Once it exists, set
# both values to empty strings to turn bootstrap creation off.
APP_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
APP_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-admin-password
APP_BOOTSTRAP_ADMIN_FULL_NAME=BlueAI Administrator
